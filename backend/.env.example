# Claritas Verify OTP Backend - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=https://your-production-frontend.example.com

# Preferred production email configuration (yagmail-compatible)
# Use the same env keys as your BGV-AI-Agent email flow.
EMAIL=your-email@gmail.com
APP_PASSWORD=your-16-character-app-password

# Optional SMTP fallback configuration
# Only needed if you do not want to use yagmail.
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-16-character-app-password

SENDER_NAME=Claritas Verify

# Set to false in production to prevent writing OTPs to last_otp.txt
DEV_EMAIL_BACKUP=false
